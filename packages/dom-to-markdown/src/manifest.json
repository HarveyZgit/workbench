{
  "manifest_version": 3,
  "name": "Local Markdown Clipper",
  "version": "1.0",
  "permissions": ["contextMenus", "activeTab", "scripting", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["lib/turndown.js", "content.js"]
  }]
}

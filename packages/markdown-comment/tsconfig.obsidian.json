{
  // Obsidian 适配器跑在 Electron 渲染进程：既要 DOM（obsidian.d.ts 引用），又要 node（storage.ts 用 fs）。
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/adapters/obsidian",
    "src/core",
    "src/storage.ts",
    "src/types.ts",
    "src/preview/messages.ts",
    "src/preview/card-ui.ts"
  ]
}

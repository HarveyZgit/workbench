{
  "name": "vscode-markdown-comment",
  "displayName": "Markdown Comment",
  "description": "为 Markdown 文档建立可重定位评论线程，并提供 VS Code、CLI 与 Agent Skill 接入。",
  "version": "1.1.0",
  "publisher": "corehr-fe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@code.byted.org/zhanghang.harvey/workbench.git",
    "directory": "packages/markdown-comment"
  },
  "publishConfig": {
    "registry": "https://bnpm.byted.org/",
    "access": "public"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "markdown-comment": "./dist/cli.js"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdown-comment.add-comment",
        "title": "Markdown Comment：添加划词评论",
        "icon": "$(comment)"
      },
      {
        "command": "markdown-comment.add-document-comment",
        "title": "Markdown Comment：添加全文评论",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "markdown-comment.open-preview",
        "title": "Markdown Comment：打开评论预览",
        "icon": "$(preview)"
      },
      {
        "command": "markdown-comment.install-or-update-skill",
        "title": "Markdown Comment：安装 / 更新 Agent Skill"
      },
      {
        "command": "markdown-comment.cleanup-skill",
        "title": "Markdown Comment：移除 Agent Skill"
      },
      {
        "command": "markdown-comment.create-thread",
        "title": "评论"
      },
      {
        "command": "markdown-comment.reply",
        "title": "回复"
      },
      {
        "command": "markdown-comment.resolve",
        "title": "标记为已解决",
        "icon": "$(check)"
      },
      {
        "command": "markdown-comment.reopen",
        "title": "重新打开",
        "icon": "$(history)"
      },
      {
        "command": "markdown-comment.edit-comment",
        "title": "编辑",
        "icon": "$(edit)"
      },
      {
        "command": "markdown-comment.delete-comment",
        "title": "删除",
        "icon": "$(trash)"
      },
      {
        "command": "markdown-comment.save-edit",
        "title": "保存"
      },
      {
        "command": "markdown-comment.cancel-edit",
        "title": "取消"
      },
      {
        "command": "markdown-comment.delete-thread",
        "title": "删除整条评论线程",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdown-comment.open-preview",
          "when": "editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markdown-comment.add-comment",
          "when": "(editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i) && config.markdownComment.sourceComments.enabled",
          "group": "1_modification"
        },
        {
          "command": "markdown-comment.add-document-comment",
          "when": "(editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i) && config.markdownComment.sourceComments.enabled",
          "group": "1_modification"
        },
        {
          "command": "markdown-comment.open-preview",
          "when": "editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i",
          "group": "1_modification"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "markdown-comment.resolve",
          "when": "commentController == markdownComment && commentThread == unresolved",
          "group": "inline"
        },
        {
          "command": "markdown-comment.reopen",
          "when": "commentController == markdownComment && commentThread == resolved",
          "group": "inline"
        },
        {
          "command": "markdown-comment.delete-thread",
          "when": "commentController == markdownComment && !commentThreadIsEmpty",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "markdown-comment.create-thread",
          "when": "commentController == markdownComment && commentThreadIsEmpty",
          "group": "inline"
        },
        {
          "command": "markdown-comment.reply",
          "when": "commentController == markdownComment && !commentThreadIsEmpty",
          "group": "inline"
        }
      ],
      "comments/comment/title": [
        {
          "command": "markdown-comment.edit-comment",
          "when": "commentController == markdownComment",
          "group": "group@1"
        },
        {
          "command": "markdown-comment.delete-comment",
          "when": "commentController == markdownComment",
          "group": "group@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "markdown-comment.cancel-edit",
          "when": "commentController == markdownComment",
          "group": "inline@1"
        },
        {
          "command": "markdown-comment.save-edit",
          "when": "commentController == markdownComment",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdown-comment.add-comment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "(editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i) && editorTextFocus && config.markdownComment.sourceComments.enabled"
      }
    ],
    "configuration": {
      "title": "Markdown Comment",
      "properties": {
        "markdownComment.sourceComments.enabled": {
          "type": "boolean",
          "default": false,
          "description": "在 Markdown 源文件里启用内联（行）评论：编辑器左侧 + 号添加、Cmd/Ctrl+Alt+M、右键菜单。默认关闭——推荐用「打开评论预览」在渲染视图里评论。开关更改后需重载窗口生效。"
        },
        "markdownComment.preview.frontMatter": {
          "type": "string",
          "default": "table",
          "enum": [
            "table",
            "codeBlock",
            "hide"
          ],
          "enumDescriptions": [
            "以键值表格渲染 YAML Front Matter。",
            "以 YAML 代码块渲染 Front Matter。",
            "隐藏 Front Matter。"
          ],
          "description": "控制 Markdown Comment 预览如何显示文档开头的 YAML Front Matter。"
        },
        "markdownComment.preview.scrollPreviewWithEditor": {
          "type": "boolean",
          "default": true,
          "description": "滚动 Markdown 源码编辑器时，同步滚动评论预览。"
        },
        "markdownComment.preview.scrollEditorWithPreview": {
          "type": "boolean",
          "default": true,
          "description": "滚动评论预览时，同步滚动 Markdown 源码编辑器。"
        },
        "markdownComment.preview.doubleClickToSwitchToEditor": {
          "type": "boolean",
          "default": true,
          "description": "双击评论预览中的内容时打开源码并定位到对应行。"
        },
        "markdownComment.preview.styles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "为 Markdown Comment 预览加载 workspace 内的本地 CSS 文件。"
        },
        "markdownComment.preview.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Markdown Comment 预览字体；留空时使用 VS Code 字体。"
        },
        "markdownComment.preview.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 40,
          "description": "Markdown Comment 预览字号（px）。"
        },
        "markdownComment.preview.lineHeight": {
          "type": "number",
          "default": 1.7,
          "minimum": 1,
          "maximum": 3,
          "description": "Markdown Comment 预览行高。"
        },
        "markdownComment.preview.breaks": {
          "type": "boolean",
          "default": false,
          "description": "将段落内换行渲染为换行标签。"
        },
        "markdownComment.preview.typographer": {
          "type": "boolean",
          "default": false,
          "description": "启用 markdown-it 的排版替换。"
        },
        "markdownComment.preview.html": {
          "type": "string",
          "default": "strict",
          "enum": [
            "strict",
            "safe"
          ],
          "enumDescriptions": [
            "不渲染 Markdown 原始 HTML。",
            "渲染经过严格清洗的静态 HTML。"
          ],
          "description": "控制 Markdown Comment 预览中的原始 HTML。"
        },
        "markdownComment.preview.renderedDiff": {
          "type": "boolean",
          "default": true,
          "description": "在预览中标记当前未保存文本相对磁盘版本的增删改行。"
        },
        "markdownComment.preview.mermaidNodeComments": {
          "type": "boolean",
          "default": false,
          "description": "实验功能：允许评论 Mermaid Flowchart 中具有显式且唯一 ID 的节点。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "setup": "node esbuild.mjs --production",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "package": "vsce package --no-dependencies --ignoreFile .vscodeignore -o dist/vscode-markdown-comment.vsix",
    "prepack": "node esbuild.mjs --production && vsce package --no-dependencies --ignoreFile .vscodeignore -o dist/vscode-markdown-comment.vsix"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.1",
    "yaml": "^2.9.0"
  }
}

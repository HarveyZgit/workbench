{
  "name": "vscode-markdown-comment",
  "displayName": "Markdown Comment",
  "description": "为 Markdown 文档建立可重定位评论线程，并提供 VS Code、CLI 与 Agent Skill 接入。",
  "version": "1.0.1",
  "publisher": "corehr-fe",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://bnpm.byted.org/",
    "access": "public"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "markdown-comment": "./dist/cli.js",
    "mdc": "./dist/cli.js"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownComment.addComment",
        "title": "Markdown 评论：添加划词评论",
        "icon": "$(comment)"
      },
      {
        "command": "markdownComment.addDocumentComment",
        "title": "Markdown 评论：添加全文评论",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "markdownComment.openPreview",
        "title": "Markdown 评论：打开评论预览",
        "icon": "$(preview)"
      },
      {
        "command": "markdownComment.createThread",
        "title": "评论"
      },
      {
        "command": "markdownComment.reply",
        "title": "回复"
      },
      {
        "command": "markdownComment.resolve",
        "title": "标记为已解决",
        "icon": "$(check)"
      },
      {
        "command": "markdownComment.reopen",
        "title": "重新打开",
        "icon": "$(history)"
      },
      {
        "command": "markdownComment.editComment",
        "title": "编辑",
        "icon": "$(edit)"
      },
      {
        "command": "markdownComment.deleteComment",
        "title": "删除",
        "icon": "$(trash)"
      },
      {
        "command": "markdownComment.saveEdit",
        "title": "保存"
      },
      {
        "command": "markdownComment.cancelEdit",
        "title": "取消"
      },
      {
        "command": "markdownComment.deleteThread",
        "title": "删除整条评论线程",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownComment.openPreview",
          "when": "editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markdownComment.addComment",
          "when": "(editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i) && config.markdownComment.sourceComments.enabled",
          "group": "1_modification"
        },
        {
          "command": "markdownComment.addDocumentComment",
          "when": "(editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i) && config.markdownComment.sourceComments.enabled",
          "group": "1_modification"
        },
        {
          "command": "markdownComment.openPreview",
          "when": "editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i",
          "group": "1_modification"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "markdownComment.resolve",
          "when": "commentController == markdownComment && commentThread == unresolved",
          "group": "inline"
        },
        {
          "command": "markdownComment.reopen",
          "when": "commentController == markdownComment && commentThread == resolved",
          "group": "inline"
        },
        {
          "command": "markdownComment.deleteThread",
          "when": "commentController == markdownComment && !commentThreadIsEmpty",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "markdownComment.createThread",
          "when": "commentController == markdownComment && commentThreadIsEmpty",
          "group": "inline"
        },
        {
          "command": "markdownComment.reply",
          "when": "commentController == markdownComment && !commentThreadIsEmpty",
          "group": "inline"
        }
      ],
      "comments/comment/title": [
        {
          "command": "markdownComment.editComment",
          "when": "commentController == markdownComment",
          "group": "group@1"
        },
        {
          "command": "markdownComment.deleteComment",
          "when": "commentController == markdownComment",
          "group": "group@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "markdownComment.cancelEdit",
          "when": "commentController == markdownComment",
          "group": "inline@1"
        },
        {
          "command": "markdownComment.saveEdit",
          "when": "commentController == markdownComment",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownComment.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "(editorLangId == markdown || resourceExtname =~ /\\.(md|markdown|mkd|mkdn|mdwn|mdown|markdn|mdtxt|mdtext)$/i) && editorTextFocus && config.markdownComment.sourceComments.enabled"
      }
    ],
    "configuration": {
      "title": "Markdown 评论",
      "properties": {
        "markdownComment.sourceComments.enabled": {
          "type": "boolean",
          "default": false,
          "description": "在 Markdown 源文件里启用内联（行）评论：编辑器左侧 + 号添加、Cmd/Ctrl+Alt+M、右键菜单。默认关闭——推荐用「打开评论预览」在渲染视图里评论。开关更改后需重载窗口生效。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "setup": "node esbuild.mjs --production && node dist/cli.js init",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "package": "vsce package --no-dependencies -o dist/vscode-markdown-comment.vsix",
    "prepack": "node esbuild.mjs --production && vsce package --no-dependencies -o dist/vscode-markdown-comment.vsix"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1"
  }
}

[
  {
    "label": "Markdown Comment: Preview current file",
    "command": "node",
    "args": [
      "$ZED_WORKTREE_ROOT/packages/markdown-comment/zed/scripts/preview.mjs",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  }
]

{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/preview/webview.ts",
    "src/preview/markdown.ts",
    "src/preview/heading.ts",
    "src/preview/mermaid.ts",
    "src/preview/navigation.ts",
    "src/adapters/obsidian"
  ]
}

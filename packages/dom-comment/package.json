{
  "name": "dom-comment",
  "version": "0.1.1",
  "private": true,
  "description": "\u5728\u9875\u9762\u4e0a\u6807\u8bb0\u5143\u7d20\u3001\u6587\u5b57\u6216\u533a\u57df\u5e76\u8bc4\u8bba\u3002",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dom-comment": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/native-host.js",
    "dist/chrome-mv3/*.js",
    "dist/chrome-mv3/*.html",
    "dist/chrome-mv3/*.png",
    "dist/chrome-mv3/manifest.json",
    "resources/skills/dom-comment",
    "chrome-extension.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-node.mjs",
    "setup": "node scripts/build-node.mjs && node dist/cli.js install-skill",
    "pack-release": "node scripts/build-node.mjs && bash scripts/pack-release.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='**/adapters/extension/**' --import tsx tests/*.test.ts"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}

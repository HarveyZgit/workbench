#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import * as fs from 'node:fs';
import * as path from 'node:path';
import { fileURLToPath } from 'node:url';

function isFile(p) {
  try {
    return fs.statSync(p).isFile();
  } catch {
    return false;
  }
}

const here = path.dirname(fileURLToPath(import.meta.url));
const pkg = path.resolve(here, '../../..');
const bundled = path.join(pkg, 'dist/cli.js');
const envCli = process.env.DOM_COMMENT_CLI;

const cli = (envCli && isFile(envCli) && envCli) || (isFile(bundled) && bundled);
if (!cli) {
  process.stderr.write('找不到 dist/cli.js。请在 packages/dom-comment 运行 rushx build。\n');
  process.exit(1);
}
const r = spawnSync(process.execPath, [cli, ...process.argv.slice(2)], { stdio: 'inherit' });
process.exit(r.status ?? 1);
